# ===========================================
# VOICERA PRODUCTION ENVIRONMENT TEMPLATE
# ===========================================
# Copy this to .env.production and fill in your values
# 
# cp .env.production.example .env.production
#
# URLs that will be created:
#   - https://${DOMAIN} (frontend)
#   - https://api.${DOMAIN} (backend API)
#   - https://voice.${DOMAIN} (voice server)

# === DOMAIN ===
DOMAIN=voicera.yourdomain.com

# === SECURITY KEYS ===
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
INTERNAL_API_KEY=

# === MONGODB ===
MONGODB_USER=admin
MONGODB_PASSWORD=
MONGODB_DATABASE=voicera

# === AWS S3 (Object Storage) ===
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=
AWS_S3_RECORDINGS_BUCKET=recordings
AWS_S3_REGION=us-east-1

# === VOBIZ TELEPHONY ===
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CALLER_ID=

# === LIVEKIT ===
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_URI=sip:your-sip-uri.sip.livekit.cloud
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_AGENT_NAME=voicera-agent

# === AI PROVIDERS ===
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# === AGENT ===
DEFAULT_AGENT_ID=agent_001

# === MEMORY ===
MEMORY_EMBED_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_COUNTRY_CODE=91
ENABLE_MEMORY_EACH_TURN=true
MEMORY_TOP_K=5
ENABLE_SMART_TURN=true

# === EGRESS RECORDING ===
ENABLE_EGRESS_RECORDING=true
