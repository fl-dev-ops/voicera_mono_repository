# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=admin

# Application Configuration
DEBUG=False

# Security Configuration
SECRET_KEY=secret_key

# Mailtrap Configuration
MAILTRAP_API_TOKEN=your-mailtrap-api-token-here
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000

# Internal API Key for service-to-service communication (bot -> backend)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-internal-api-key-here

# AWS S3 Configuration
AWS_S3_ENDPOINT=minio:9000
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadmin

# Vobiz API Configuration
VOBIZ_API_BASE_URL=your-vobiz-base-url
VOBIZ_ACCOUNT_ID=your-vobiz-account-id
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token

# Evaluation (forever-learning parity)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_URI=sip:your-sip-uri.sip.livekit.cloud
LIVEKIT_AGENT_NAME=voicera-agent
