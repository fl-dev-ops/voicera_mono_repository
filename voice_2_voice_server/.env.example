# ============================================
# Voice Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === LiveKit Server ===
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# === Agent Name ===
# Must match the agent_name in WorkerOptions - used for dispatch rules
LIVEKIT_AGENT_NAME=voicera-agent

# === LiveKit SIP Trunking ===
# Outbound trunk ID from LiveKit SIP settings
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxxxxx

# === Agent Defaults ===
# Fallback agent ID if not supplied in room metadata
DEFAULT_AGENT_ID=your-default-agent-id

# === Backend API ===
VOICERA_BACKEND_URL=http://localhost:8000
# Internal API key for secure service-to-service communication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-internal-api-key-here

# === MinIO Storage ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RECORDINGS_BUCKET=recordings
MINIO_REGION=us-east-1

# === STT: Deepgram ===
DEEPGRAM_API_KEY=your-deepgram-api-key

# === TTS: Sarvam ===
SARVAM_API_KEY=your-sarvam-api-key

# === LLM: OpenAI ===
OPENAI_API_KEY=your-openai-api-key

# === LLM: Google / Gemini (optional) ===
GOOGLE_API_KEY=your-google-api-key

# === Memory Settings ===
ENABLE_MEMORY_EACH_TURN=true
MEMORY_TOP_K=5
ENABLE_SMART_TURN=true

# === Egress Recording ===
# Enable/disable call audio recording via LiveKit Egress
ENABLE_EGRESS_RECORDING=true
